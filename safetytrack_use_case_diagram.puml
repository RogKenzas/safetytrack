@startuml SafetyTrack_UseCase_Diagram

!theme plain
skinparam backgroundColor #F8FAF9
skinparam actorBackgroundColor #179D5B
skinparam actorBorderColor #179D5B
skinparam usecaseBackgroundColor #E8F5EF
skinparam usecaseBorderColor #179D5B
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #179D5B

title Diagramme de Cas d'Utilisation - SafetyTrack

' Acteurs
actor "Parent/Tuteur" as Parent #179D5B
actor "Enfant" as Child #4CAF50
actor "Système de Géolocalisation" as GPS #FF9800
actor "Firebase" as Firebase #2196F3

' Package Authentification
package "Authentification" {
    usecase "Se connecter" as UC1
    usecase "S'inscrire" as UC2
    usecase "Réinitialiser mot de passe" as UC3
    usecase "Se déconnecter" as UC4
    usecase "Authentification Google" as UC5
}

' Package Gestion des Comptes
package "Gestion des Comptes" {
    usecase "Créer compte enfant" as UC6
    usecase "Lier compte enfant" as UC7
    usecase "Gérer profil" as UC8
    usecase "Configurer type de compte" as UC9
}

' Package Onboarding
package "Configuration Initiale" {
    usecase "Compléter onboarding" as UC10
    usecase "Configurer zones d'alerte" as UC11
    usecase "Ajouter adresses importantes" as UC12
    usecase "Finaliser configuration" as UC13
}

' Package Géolocalisation
package "Géolocalisation et Suivi" {
    usecase "Obtenir position GPS" as UC14
    usecase "Mettre à jour position" as UC15
    usecase "Géocoder adresse" as UC16
    usecase "Suivre enfant en temps réel" as UC17
    usecase "Afficher position sur carte" as UC18
}

' Package Zones d'Alerte
package "Gestion des Zones d'Alerte" {
    usecase "Créer zone d'alerte" as UC19
    usecase "Marquer zone sur carte" as UC20
    usecase "Nommer zone d'alerte" as UC21
    usecase "Détecter entrée en zone" as UC22
    usecase "Déclencher alerte panique" as UC23
    usecase "Propager zones aux enfants" as UC24
}

' Package Gestion des Adresses
package "Gestion des Adresses" {
    usecase "Ajouter adresse personnelle" as UC25
    usecase "Marquer adresse sur carte" as UC26
    usecase "Classifier adresse (Maison/École)" as UC27
    usecase "Synchroniser adresses parent-enfant" as UC28
    usecase "Géolocaliser automatiquement" as UC29
}

' Package Tableaux de Bord
package "Tableaux de Bord" {
    usecase "Accéder dashboard parent" as UC30
    usecase "Accéder dashboard enfant" as UC31
    usecase "Visualiser carte interactive" as UC32
    usecase "Naviguer par onglets" as UC33
    usecase "Afficher statut enfants" as UC34
    usecase "Monitoring temps réel" as UC35
}

' Package Système d'Alertes
package "Système d'Alertes" {
    usecase "Recevoir notification proximité" as UC36
    usecase "Afficher interface panique" as UC37
    usecase "Compte à rebours urgence" as UC38
    usecase "Appeler numéro d'urgence" as UC39
    usecase "Localiser en urgence" as UC40
    usecase "Envoyer notification push" as UC41
}

' Package Synchronisation
package "Synchronisation" {
    usecase "Synchroniser données parent-enfant" as UC42
    usecase "Propager zones d'alerte" as UC43
    usecase "Mettre à jour temps réel" as UC44
    usecase "Gérer connectivité" as UC45
}

